 "fields": [
  {
   "fieldname": "message_tab",
   "fieldtype": "Tab Break",
   "label": "Message"
  },
  {
   "fieldname": "title",
   "fieldtype": "Data",
   "in_list_view": 1,
   "label": "Title",
   "reqd": 1
  },
  {
   "description": "The WhatsApp number this broadcast is sent from. Empty uses the default outgoing number.",
   "fieldname": "whatsapp_account",
   "fieldtype": "Link",
   "in_standard_filter": 1,
   "label": "Send From",
   "options": "OneChat Account"
  },
  {
   "fieldname": "from_number",
   "fieldtype": "Data",
   "hidden": 1,
   "in_list_view": 1,
   "label": "From WhatsApp Number"
  },
  {
   "description": "Leave empty to send immediately after submission",
   "fieldname": "scheduled_time",
   "fieldtype": "Datetime",
   "label": "Scheduled Time"
  },
  {
   "default": "0",
   "description": "Send each person at the hour they usually message you, within the next 24 hours. People with no history get it right away.",
   "fieldname": "smart_send",
   "fieldtype": "Check",
   "label": "Smart send time"
  },
  {
   "fieldname": "smart_queue",
   "fieldtype": "Long Text",
   "hidden": 1,
   "label": "Smart Send Queue",
   "no_copy": 1,
   "read_only": 1
  },
  {
   "fieldname": "follow_up_of",
   "fieldtype": "Link",
   "label": "Follow-up Of",
   "no_copy": 1,
   "options": "Bulk WhatsApp Message",
   "read_only": 1
  },
  {
   "fieldname": "follow_up_audience",
   "fieldtype": "Data",
   "label": "Follow-up Audience",
   "no_copy": 1,
   "read_only": 1
  },
  {
   "fieldname": "message_0_column_1",
   "fieldtype": "Column Break"
  },
  {
   "default": "Draft",
   "fieldname": "status",
   "fieldtype": "Select",
   "in_list_view": 1,
   "label": "Status",
   "options": "Draft\nQueued\nIn Progress\nCompleted\nPartially Failed",
   "read_only": 1
  },
  {
   "default": "0",
   "fieldname": "sent_count",
   "fieldtype": "Int",
   "label": "Sent Count",
   "read_only": 1
  },
  {
   "allow_on_submit": 1,
   "default": "0",
