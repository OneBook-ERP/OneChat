   "fieldname": "skipped_count",
   "fieldtype": "Int",
   "label": "Skipped (Opted Out)",
   "no_copy": 1,
   "read_only": 1
  },
  {
   "fieldname": "amended_from",
   "fieldtype": "Link",
   "label": "Amended From",
   "no_copy": 1,
   "options": "Bulk WhatsApp Message",
   "print_hide": 1,
   "read_only": 1
  },
