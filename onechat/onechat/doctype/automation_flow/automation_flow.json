   "fieldname": "flow_tab",
   "fieldtype": "Tab Break",
   "label": "Flow"
  },
  {
   "fieldname": "flow_name",
   "fieldtype": "Data",
   "in_list_view": 1,
   "label": "Flow Name",
   "reqd": 1,
   "unique": 1
  },
  {
   "fieldname": "trigger_type",
   "fieldtype": "Select",
   "in_list_view": 1,
   "label": "Trigger Type",
   "options": "WhatsApp Incoming\nERPNext Document Event\nScheduled\nManual\nWebhook"
  },
  {
   "fieldname": "flow_0_column_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "category",
   "fieldtype": "Select",
   "label": "Category",
   "options": "Customer Service\nSales\nSupport\nNotifications\nWorkflow Automation\nOther"
  },
  {
   "default": "1",
   "fieldname": "is_active",
   "fieldtype": "Check",
   "in_list_view": 1,
   "label": "Is Active"
  },
  {
   "fieldname": "flow_1_section",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "description",
   "fieldtype": "Small Text",
   "label": "Description"
  },
  {
   "fieldname": "behaviour_section",
   "fieldtype": "Section Break",
   "label": "Behaviour"
  },
  {
   "default": "1",
   "description": "Stop the bot for a conversation as soon as an agent replies by hand.",
   "fieldname": "stop_on_agent_reply",
   "fieldtype": "Check",
   "label": "Stop when an agent replies"
  },
  {
   "fieldname": "behaviour_column_1",
   "fieldtype": "Column Break"
  },
  {
   "default": "24",
   "description": "How long the bot waits for an answer before giving up. WhatsApp only allows free-form replies for 24 hours.",
   "fieldname": "reply_timeout_hours",
   "fieldtype": "Int",
   "label": "Wait for replies (hours)",
   "non_negative": 1
  },
  {
   "fieldname": "errors_section",
   "fieldtype": "Section Break",
   "label": "When a Step Fails"
  },
  {
   "default": "Sorry, something went wrong on our side. A teammate will reply to you shortly.",
   "description": "Sent to the customer when a step fails and no On error path handles it. Leave empty to send nothing.",
   "fieldname": "error_message",
   "fieldtype": "Small Text",
   "label": "Message to Customer"
  },
  {
   "default": "1",
   "description": "Stop the bot and give the chat to the next available agent.",
   "fieldname": "error_handover",
   "fieldtype": "Check",
   "label": "Hand Over to an Agent"
  },
  {
   "depends_on": "error_handover",
   "fieldname": "error_team",
   "fieldtype": "Link",
   "label": "Hand Over to Team",
   "options": "OneChat Team"
  },
  {
   "fieldname": "when_a_step_fails_column_1",
   "fieldtype": "Column Break"
  },
  {
   "default": "1",
   "description": "Alert admins when this flow fails several times within an hour.",
   "fieldname": "error_notify",
   "fieldtype": "Check",
   "label": "Alert Admins on Repeated Failures"
  },
  {
   "default": "0",
   "description": "Turn the flow off automatically after 5 failures within an hour.",
   "fieldname": "error_pause",
   "fieldtype": "Check",
   "label": "Pause on Repeated Failures"
  },
  {
   "fieldname": "definition_tab",
   "fieldtype": "Tab Break",
   "label": "Definition"
  },
  {
   "fieldname": "graph_json",
   "fieldtype": "Code",
   "label": "Graph JSON"
  },
  {
   "description": "Unpublished changes to the steps and trigger of an active flow.",
